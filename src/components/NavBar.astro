---
// Plain Bootstrap markup (no React island) — Bootstrap's own JS bundle
// (loaded once below) drives the collapse behaviour, the same engine that
// sat behind react-bootstrap in the previous Gatsby version.
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}webgis/`, label: "Map of the sites" },
  { href: `${base}data/`, label: "Data" },
  { href: `${base}entries-description/`, label: "Entries Description" },
  { href: `${base}bibliography/`, label: "Bibliography" },
  { href: `${base}credits/`, label: "Credits" },
];
---

<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container">
    <a class="navbar-brand" href={base}>ELAMortuary</a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavbar"
      aria-controls="mainNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav me-auto">
        {
          links.map((link) => (
            <li class="nav-item">
              <a class="nav-link my-2" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  import "bootstrap/dist/js/bootstrap.bundle.min.js";
</script>
